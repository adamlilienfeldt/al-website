---
interface Props {
  title: string;
  role?: string;
  director?: string;
  film_company?: string;
  year?: string;
  link?: string;
  cover?: string;
  vimeo_id?: string;
}

const { title, role, director, film_company, year, link, cover, vimeo_id } = Astro.props;
const isVideo = Boolean(vimeo_id);
const hasLink = Boolean(link) && !isVideo;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const coverSrc = cover && !cover.startsWith('http') ? `${base}${cover}` : cover;
---

{isVideo ? (
  <div class="film-card film-card--video" data-vimeo={vimeo_id}>
    <div class="film-video-wrapper">
      <iframe
        src={`https://player.vimeo.com/video/${vimeo_id}`}
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
        title={title}
      />
      <div class="film-video-cover">
        <p class="film-overlay-title">{title}</p>
        {role && <p class="film-overlay-meta">{role}</p>}
        {director && <p class="film-overlay-meta">dir. {director}</p>}
        {film_company && <p class="film-overlay-meta">{film_company}</p>}
      </div>
    </div>
  </div>
) : (
  <div
    class:list={['film-card film-card--poster card', { 'has-link': hasLink }]}
    data-link={link || ''}
    role={hasLink ? 'link' : undefined}
    tabindex={hasLink ? 0 : undefined}
    aria-label={hasLink ? `${title} — open link` : undefined}
  >
    {coverSrc
      ? <img src={coverSrc} alt={title} loading="lazy" />
      : <div class="card-placeholder" aria-hidden="true" />
    }
    <div class="card-overlay">
      <p class="card-heading">{title}</p>
      {role && <p class="card-credits">{role}</p>}
      {director && <p class="card-credits">dir. {director}</p>}
      {film_company && <p class="card-credits">{film_company}</p>}
      {year && <p class="card-credits">{year}</p>}
    </div>
  </div>
)}

{isVideo && (
  <script>
    function revealVideo(card: HTMLElement) {
      card.classList.remove('active');
      card.classList.add('revealed');
    }

    document.querySelectorAll<HTMLElement>('.film-card--video').forEach((card) => {
      const cover = card.querySelector<HTMLElement>('.film-video-cover');
      if (!cover) return;
      const isTouchDevice = window.matchMedia('(hover: none)').matches;

      if (isTouchDevice) {
        // Add a transparent blocker over the iframe to capture taps
        const blocker = document.createElement('div');
        blocker.className = 'film-touch-blocker';
        card.querySelector('.film-video-wrapper')!.appendChild(blocker);

        blocker.addEventListener('click', () => {
          if (!card.classList.contains('active')) {
            card.classList.add('active');
          } else {
            revealVideo(card);
          }
        });

        cover.addEventListener('click', () => {
          if (card.classList.contains('active')) {
            revealVideo(card);
          }
        });
      } else {
        // Desktop: click overlay → reveal and autoplay
        cover.addEventListener('click', () => {
          revealVideo(card);
        });
      }
    });

    // Mobile: dismiss overlay when tapping elsewhere
    document.addEventListener('click', (e) => {
      const target = e.target as Element;
      document.querySelectorAll<HTMLElement>('.film-card--video.active').forEach((card) => {
        if (!card.contains(target)) card.classList.remove('active');
      });
    });
  </script>
)}

{!isVideo && (
  <script>
    function initCards() {
      const cards = document.querySelectorAll<HTMLElement>('.card');
      document.addEventListener('click', (e) => {
        const target = e.target as Element;
        const clickedCard = target.closest<HTMLElement>('.card');
        cards.forEach((card) => {
          if (card === clickedCard) return;
          card.classList.remove('active');
        });
        if (!clickedCard) return;
        const isTouchDevice = window.matchMedia('(hover: none)').matches;
        if (isTouchDevice) {
          const link = clickedCard.dataset.link;
          if (clickedCard.classList.contains('active')) {
            if (link) window.open(link, '_blank', 'noopener');
            clickedCard.classList.remove('active');
          } else {
            clickedCard.classList.add('active');
          }
        } else {
          const link = clickedCard.dataset.link;
          if (link) window.open(link, '_blank', 'noopener');
        }
      });
      cards.forEach((card) => {
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            const link = card.dataset.link;
            if (link) window.open(link, '_blank', 'noopener');
          }
        });
      });
    }
    initCards();
  </script>
)}
