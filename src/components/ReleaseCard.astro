---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SHOW_TYPE, SHOW_YEAR, SHOW_CREDITS, SHOW_LABEL } from '../config';

interface Props {
  artist: string;
  title: string;
  type?: string;
  year?: string;
  link?: string;
  services?: Record<string, string>;
  cover?: ImageMetadata;
  credits?: string;
  label?: string;
}

const { artist, title, type, year, link, services, cover, credits, label } = Astro.props;
const hasLink = Boolean(link) || Boolean(services && Object.keys(services).length);
const coverSrc = cover;
---

<div
  class:list={['card', { 'has-link': hasLink }]}
  data-link={link || ''}
  data-services={services && Object.keys(services).length ? JSON.stringify(services) : ''}
  role={hasLink ? 'button' : undefined}
  aria-haspopup={hasLink ? 'dialog' : undefined}
  tabindex={hasLink ? 0 : undefined}
  aria-label={hasLink ? `${title} by ${artist} — open on streaming` : undefined}
>
  {coverSrc
    ? <Picture
        src={coverSrc}
        formats={['avif', 'webp']}
        widths={[330, 660, 1000]}
        sizes="(max-width: 600px) 50vw, (max-width: 900px) 33vw, 25vw"
        alt={`${title} by ${artist}`}
        loading="lazy"
      />
    : <div class="card-placeholder" aria-hidden="true" />
  }

  <div class="card-overlay">
    <p class="card-heading">{artist} - {title}</p>
    {SHOW_CREDITS && credits && <p class="card-credits">{credits}</p>}
    {SHOW_LABEL && label && <p class="card-label">({label})</p>}
    {(SHOW_YEAR && year || SHOW_TYPE && type) && (
      <div class="card-meta">
        {SHOW_YEAR && year && <span class="card-year">{year}</span>}
        {SHOW_TYPE && type && <span class="card-type">{type}</span>}
      </div>
    )}
  </div>
</div>

<script>
  import { SERVICES, musicAppUrl } from '../lib/services';

  function initCards() {
    const cards = document.querySelectorAll<HTMLElement>('.card');

    // Create modal once. A native <dialog> opened with showModal() traps focus,
    // closes on Esc, makes the page behind inert, and returns focus on close.
    let modal = document.getElementById('odesli-modal') as HTMLDialogElement | null;
    if (!modal) {
      modal = document.createElement('dialog');
      modal.id = 'odesli-modal';
      modal.className = 'odesli-modal';
      modal.innerHTML = `
        <div class="odesli-modal-content">
          <button class="odesli-modal-close" aria-label="Close">&times;</button>
          <div class="odesli-services"></div>
        </div>`;
      document.body.appendChild(modal);
    }

    const servicesEl = modal.querySelector('.odesli-services') as HTMLElement;
    const closeBtn = modal.querySelector('.odesli-modal-close') as HTMLElement;

    // Escape a value for safe interpolation into HTML attributes / text. The
    // service URLs and titles come from external APIs (Odesli / iTunes) via
    // data-* attributes, so never trust them in innerHTML unescaped.
    function esc(s: string): string {
      return String(s ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Build the <a> service links for a card; empty string if nothing to show.
    function buildLinks(services: Record<string, string>, fallback: string): string {
      const entries = Object.entries(SERVICES)
        .filter(([key]) => services[key])
        .map(([key, meta]) => ({ key, label: meta.label, icon: meta.icon, url: services[key] }));
      if (entries.length === 0 && fallback) {
        entries.push({ key: '', label: 'Open in streaming app', icon: '', url: fallback });
      }
      return entries
        .map(
          (e) =>
            `<a class="odesli-service${e.icon ? ' has-icon' : ''}" data-service="${e.key}" href="${esc(e.url)}" target="_blank" rel="noopener noreferrer" aria-label="${esc(e.label)}" title="${esc(e.label)}">${e.icon || esc(e.label)}</a>`,
        )
        .join('');
    }

    function cardData(card: HTMLElement) {
      const link = card.dataset.link || '';
      let services: Record<string, string> = {};
      try {
        services = card.dataset.services ? JSON.parse(card.dataset.services) : {};
      } catch {}
      return { link, services, has: !!link || Object.keys(services).length > 0 };
    }

    // Cover size in the popup; keep in sync with .odesli-modal-cover in global.css.
    const MODAL_COVER_SIZES = 'min(440px, 76vw, 55vh)';

    function openModal(card: HTMLElement) {
      const { link, services } = cardData(card);
      const text = (sel: string) => esc(card.querySelector(sel)?.textContent || '');
      const heading = text('.card-heading');
      // Credits and label come from the card overlay, so the SHOW_* config
      // flags apply here too.
      const credits = text('.card-credits');
      const label = text('.card-label');
      servicesEl.innerHTML = `
        <div class="odesli-modal-meta">
          ${heading ? `<p class="odesli-modal-title">${heading}</p>` : ''}
          ${credits ? `<p class="odesli-modal-info">${credits}</p>` : ''}
          ${label ? `<p class="odesli-modal-info">${label}</p>` : ''}
        </div>
        <div class="odesli-services-row">${buildLinks(services, link)}</div>`;

      // Reuse the card's own <picture> so the browser still picks format and
      // resolution, just for the popup's larger size.
      const picture = card.querySelector('picture')?.cloneNode(true) as HTMLElement | undefined;
      if (picture) {
        picture.querySelectorAll('source, img').forEach((el) => el.setAttribute('sizes', MODAL_COVER_SIZES));
        const img = picture.querySelector('img')!;
        img.className = 'odesli-modal-cover';
        img.alt = '';
        img.loading = 'eager';
        servicesEl.prepend(picture);
      }

      modal!.setAttribute('aria-label', card.querySelector('.card-heading')?.textContent || 'Listen');
      modal!.showModal();
    }
    function closeModal() {
      modal!.close();
    }

    function openFromCard(card: HTMLElement) {
      if (cardData(card).has) openModal(card);
    }

    servicesEl.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-service="appleMusic"]');
      const app = a && musicAppUrl(a.href);
      if (!app) return;
      e.preventDefault();
      window.location.href = app;
    });

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Element;
      const clickedCard = target.closest<HTMLElement>('.card');

      cards.forEach((card) => {
        if (card === clickedCard) return;
        card.classList.remove('active');
      });

      if (!clickedCard) return;

      const isTouchDevice = window.matchMedia('(hover: none)').matches;

      // On touch, the first tap reveals the info overlay (.active); a second
      // tap opens the picker. Desktop opens immediately on click.
      if (isTouchDevice) {
        if (clickedCard.classList.contains('active')) {
          openFromCard(clickedCard);
          clickedCard.classList.remove('active');
        } else {
          clickedCard.classList.add('active');
        }
      } else {
        openFromCard(clickedCard);
      }
    });

    cards.forEach((card) => {
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openFromCard(card);
        }
      });
    });
  }

  initCards();
</script>
