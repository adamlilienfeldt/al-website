---
import Layout from '../layouts/Layout.astro';
import FilmCard from '../components/FilmCard.astro';
import films from '../data/film.json';
import { resolveCover } from '../lib/covers';

const sorted = [...films].sort((a, b) => ((a as any).order ?? Infinity) - ((b as any).order ?? Infinity));
const videos = sorted.filter((f) => f.vimeo_id);
const posters = sorted.filter((f) => !f.vimeo_id);
---

<Layout title="film — adam lilienfeldt" activePage="film">
  <header class="hero">
    <p>some films i've worked on</p>
  </header>
  <div class="film-grid">
    <div class="film-col">
      {videos.map((film) => (
        <FilmCard
          title={film.title}
          role={film.role}
          director={(film as any).director}
          film_company={(film as any).film_company}
          year={film.year}
          link={film.link}
          cover={resolveCover(film.cover)}
          vimeo_id={film.vimeo_id}
        />
      ))}
    </div>
    <div class="film-col">
      {posters.map((film) => (
        <FilmCard
          title={film.title}
          role={film.role}
          director={(film as any).director}
          film_company={(film as any).film_company}
          year={film.year}
          link={film.link}
          cover={resolveCover(film.cover)}
          vimeo_id={film.vimeo_id}
        />
      ))}
    </div>
  </div>
</Layout>
