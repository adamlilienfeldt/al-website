---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ReleaseCard from '../components/ReleaseCard.astro';
import releases from '../data/music.json';
import { resolveCover } from '../lib/covers';
import { SHOW_PHOTO } from '../config';
import heroPhoto from '../assets/_DSC5353-1.jpeg';

const sorted = [...releases].sort((a, b) => {
  const aOrder = (a as any).order ?? Infinity;
  const bOrder = (b as any).order ?? Infinity;
  return aOrder - bOrder;
});
---

<Layout title="music — adam lilienfeldt" activePage="music">
  <header class:list={["hero", { "hero--with-photo": SHOW_PHOTO }]}>
    {SHOW_PHOTO && (
      <>
        <Image class="hero-photo" src={heroPhoto} alt="adam lilienfeldt" id="hero-photo-thumb" width={192} />
        <div class="photo-modal" id="photo-modal">
          <Image src={heroPhoto} alt="adam lilienfeldt" width={960} />
        </div>
      </>
    )}
    <div class="hero-text">
      <p>producer, engineer, musician and composer based in copenhagen.</p>
      <p>reach out at <a href="mailto:lilienfeldt.adam@gmail.com">lilienfeldt.adam@gmail.com</a></p>
    </div>
  </header>
  <div class="grid">
    {sorted.map((release) => (
      <ReleaseCard
        artist={release.artist}
        title={release.title}
        type={release.type}
        year={release.year}
        link={release.link}
        services={(release as any).services}
        cover={resolveCover(release.cover)}
        credits={release.credits}
        label={release.label}
      />
    ))}
  </div>
</Layout>

<script>
  const thumb = document.getElementById('hero-photo-thumb');
  const modal = document.getElementById('photo-modal');
  if (thumb && modal) {
    thumb.addEventListener('click', () => modal.classList.add('open'));
    modal.addEventListener('click', () => modal.classList.remove('open'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') modal.classList.remove('open');
    });
  }
</script>
