---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { SERVICES } from '../../lib/services';

// Link-only playlist pages, one per src/data/playlists/<slug>.json, made by
// `npm run playlist:add`. Not in the nav, the sitemap or search results.

interface Track {
  title: string;
  artist: string;
  duration?: number;
  cover?: string;
  songLink: string;
  services: Record<string, string>;
}

interface Playlist {
  title: string;
  description?: string;
  spotifyPlaylistUrl?: string;
  tracks: Track[];
}

// Services in the picker, in order. A track missing the chosen one links to
// its song.link page instead.
const PICKER = ['spotify', 'appleMusic', 'tidal'];

export function getStaticPaths() {
  const files = import.meta.glob<{ default: Playlist }>('../../data/playlists/*.json', { eager: true });
  return Object.entries(files).map(([path, mod]) => ({
    params: { slug: path.split('/').pop()!.replace(/\.json$/, '') },
    props: { playlist: mod.default },
  }));
}

const covers = import.meta.glob<{ default: ImageMetadata }>('../../assets/playlists/*.jpg', { eager: true });
const coverFor = (file?: string) => file && covers[`../../assets/playlists/${file}`]?.default;

const { playlist } = Astro.props as { playlist: Playlist };
const { title, description, spotifyPlaylistUrl, tracks } = playlist;

const fmt = (s: number) =>
  s >= 3600
    ? `${Math.floor(s / 3600)}:${String(Math.floor((s % 3600) / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`
    : `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
const total = tracks.reduce((sum, t) => sum + (t.duration ?? 0), 0);
const summary = `${tracks.length} tracks${total ? ` · ${fmt(total)}` : ''}`;
---

<Layout
  title={`${title} — adam lilienfeldt`}
  description={description || summary}
  ogImage={coverFor(tracks[0]?.cover) || undefined}
  noindex
>
  <header class="hero playlist-hero">
    <h1>{title}</h1>
    {description && <p>{description}</p>}
    <p>{summary}</p>
  </header>

  <div class="playlist">
    <div class="playlist-picker" role="group" aria-label="open tracks in">
      {PICKER.map((key, i) => (
        <button
          type="button"
          class="odesli-service has-icon"
          data-service={key}
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-label={SERVICES[key].label}
          title={SERVICES[key].label}
          set:html={SERVICES[key].icon}
        />
      ))}
    </div>

    {spotifyPlaylistUrl && (
      <a class="playlist-full" href={spotifyPlaylistUrl} target="_blank" rel="noopener noreferrer" data-only="spotify">
        open the full playlist on spotify
      </a>
    )}

    <ol class="playlist-tracks">
      {tracks.map((t, i) => {
        const cover = coverFor(t.cover);
        return (
          <li>
            <a
              class="playlist-track"
              href={t.services.spotify || t.songLink}
              target="_blank"
              rel="noopener noreferrer"
              data-song-link={t.songLink}
              data-links={JSON.stringify(t.services)}
            >
              <span class="playlist-num">{i + 1}</span>
              {cover
                ? <Image src={cover} alt="" width={96} height={96} loading="lazy" class="playlist-cover" />
                : <span class="playlist-cover" aria-hidden="true" />}
              <span class="playlist-text">
                <span class="playlist-title">{t.title}</span>
                <span class="playlist-artist">{t.artist}</span>
              </span>
              <span class="playlist-fallback">via song.link</span>
              {t.duration != null && <span class="playlist-duration">{fmt(t.duration)}</span>}
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</Layout>

<script>
  import { musicAppUrl } from '../../lib/services';

  const KEY = 'playlist-service';
  const buttons = document.querySelectorAll<HTMLButtonElement>('.playlist-picker button');
  const rows = document.querySelectorAll<HTMLAnchorElement>('.playlist-track');
  const full = document.querySelector<HTMLElement>('.playlist-full');

  function select(service: string) {
    if (![...buttons].some((b) => b.dataset.service === service)) return;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.service === service)));
    rows.forEach((a) => {
      const url = JSON.parse(a.dataset.links || '{}')[service];
      a.href = url || a.dataset.songLink!;
      a.classList.toggle('is-fallback', !url);
    });
    if (full) full.hidden = service !== full.dataset.only;
  }

  // Storage can throw (private windows, blocked site data); the picker still
  // works, it just doesn't remember.
  try {
    const saved = localStorage.getItem(KEY);
    if (saved) select(saved);
  } catch {}

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      select(b.dataset.service!);
      try {
        localStorage.setItem(KEY, b.dataset.service!);
      } catch {}
    }),
  );

  document.querySelector('.playlist-tracks')!.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('.playlist-track');
    const app = a && musicAppUrl(a.href);
    if (!app) return;
    e.preventDefault();
    window.location.href = app;
  });
</script>
